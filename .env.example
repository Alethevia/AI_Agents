# Environment Configuration
ENV=development  # development, staging, production

# API Keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=trading_db

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=trading_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Trading Brokers
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # paper trading

INTERACTIVE_BROKERS_HOST=127.0.0.1
INTERACTIVE_BROKERS_PORT=7497
INTERACTIVE_BROKERS_CLIENT_ID=1

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/trading_system

# Trading Configuration
MAX_POSITION_SIZE=100000
MAX_PORTFOLIO_RISK=0.02
MAX_DRAWDOWN=0.15
TRADING_HOURS_START=09:30
TRADING_HOURS_END=16:00

# Model Configuration
MODEL_UPDATE_INTERVAL=3600  # seconds
FEATURE_UPDATE_INTERVAL=60
PREDICTION_HORIZON=60  # minutes

# Risk Management
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.05
MAX_LEVERAGE=2.0
RISK_FREE_RATE=0.045

# Performance
NUM_WORKERS=8
BATCH_SIZE=256
PREFETCH_FACTOR=2
